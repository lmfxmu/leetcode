# --- 操作系统文件 (OS Generated) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- 常见 IDE 和编辑器配置 (IDE & Editors) ---
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains (IntelliJ, CLion, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Visual Studio
.vs/
Debug/
Release/
*.user

# --- 编译输出与临时文件 (Compiled & Temporary) ---

# C / C++
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.o
*.obj
*.gch

# Java
*.class
*.log
*.jar
*.war

# Python
__pycache__/
*.py[cod]
*$py.class
# 虚拟环境 (如果你在本地用了 venv)
venv/
env/
.env

# Go
# 如果你的 Go 编译输出了二进制文件，通常没有后缀
# 这里忽略常见的 output 文件名，或者你可以指定忽略 bin/ 目录
bin/
*.test
*.prof

# JavaScript / TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/

# --- 刷题常用的输入输出测试文件 (Optional) ---
# 如果你在本地调试时习惯用 input.txt 作为重定向输入
input.txt
output.txt
test.txt
temp/